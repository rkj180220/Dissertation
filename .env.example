# =============================================================================
# Cloud Orchestrator IDSS — Environment Variables
# =============================================================================
# Copy to .env and fill in your secrets:  cp .env.example .env

# --- Application (prefix: APP_) ---------------------------------------------
APP_ENV=development          # development | staging | production
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SKU_CACHE_DB_PATH=data/sku_cache.db
APP_SKU_CACHE_TTL_HOURS=24

# --- LLM Provider (prefix: LLM_) --------------------------------------------
LLM_PROVIDER=bedrock         # bedrock | gemini
LLM_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- AWS (prefix: AWS_) — Bedrock LLM + Pricing API -------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=           # optional — for temporary / SSO credentials
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_REGION=          # leave blank to use DEFAULT_REGION

# --- Azure (prefix: AZURE_) — Pricing API -----------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- GCP (prefix: GCP_) — Pricing API ---------------------------------------
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# --- LangFuse (prefix: LANGFUSE_) — LLM Observability -----------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-local-dissertation
LANGFUSE_SECRET_KEY=sk-lf-local-dissertation
LANGFUSE_HOST=http://localhost:3000
